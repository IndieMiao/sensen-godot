; Engine configuration file.
config_version=5

[application]
config/name="SensenAvatar"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/main_scene="res://scenes/city_select/city_select.tscn"
boot_splash/bg_color=Color(1, 0.992157, 0.972549, 1)
boot_splash/show_image=false

[autoload]
Localization="*res://modules/ui/localization.gd"
Avatar="*res://modules/avatar/avatar_service.gd"
AppRouter="*res://modules/ui/app_router.gd"
Net="*res://modules/net/net_service.gd"
Voice="*res://modules/net/voice_session.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/per_pixel_transparency/allowed=true

[gui]

common/default_scroll_deadzone=24
theme/custom="res://assets/ui/app_theme.tres"
theme/custom_font="res://assets/ui/fonts/NotoSansSC-Regular.otf"

[input_devices]

pointing/android/enable_pan_and_scale_gestures=false
pointing/android/disable_scroll_deadzone=true

[internationalization]

locale/fallback="en"

[editor_plugins]
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
; Keep desktop art review and Android on the same shadow budget and filtering.
; Godot's implicit mobile override otherwise disables soft-shadow filtering.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
textures/vram_compression/import_etc2_astc=true

[sensen]

network/base_url="https://farm.sensenjoy.cn/v1"
network/mobile_base_url="https://farm.sensenjoy.cn/preview/journey/v1"

[threading]

; SGODOT-227 scene integration: on a 2-core Android device the default pool (one thread per core) starves while
; the Coffee Shop kit loads its shared plants on the main thread, and the room never opens (emulator, 0 % CPU,
; every thread in futex wait). Eight threads open it. Desktop keeps its default.
; SGODOT-252 measured it on a 1-core emulator: 1 thread hangs every time; 3 or 8 open, whatever the low-priority
; ratio. Nested waits each hold a worker; too few and they wait on each other. Guarded by test_p0_project_settings.
worker_pool/max_threads.mobile=8

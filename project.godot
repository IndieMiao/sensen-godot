; Engine configuration file.
config_version=5

[application]
config/name="SensenAvatar"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/map_poc/map_poc.tscn"

[autoload]
Avatar="*res://modules/avatar/avatar_service.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/per_pixel_transparency/allowed=true

[gui]

common/default_scroll_deadzone=24
theme/custom="res://assets/ui/app_theme.tres"
theme/custom_font="res://assets/ui/fonts/NotoSansSC-Regular.otf"

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[editor_plugins]
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

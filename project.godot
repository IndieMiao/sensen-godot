; Engine configuration file.
config_version=5

[application]
config/name="SensenAvatar"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/brand/logo_mark.svg"
config/quit_on_go_back=false
run/main_scene="res://scenes/app/boot.tscn"
boot_splash/bg_color=Color(0.988235, 0.996078, 0.980392, 1)
boot_splash/image="res://assets/brand/generated/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]
Avatar="*res://modules/avatar/avatar_service.gd"
AppRouter="*res://modules/ui/app_router.gd"
Net="*res://modules/net/net_service.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/per_pixel_transparency/allowed=true

[gui]

common/default_scroll_deadzone=24
theme/custom="res://assets/ui/app_theme.tres"
theme/custom_font="res://assets/ui/fonts/NotoSansSC-Regular.otf"

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://locale/en.po", "res://locale/zh_CN.po")

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true

[editor_plugins]
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/sensen_photo_picker/plugin.cfg", "res://addons/sensen_push/plugin.cfg", "res://addons/sensen_voice/plugin.cfg", "res://addons/sensen_map/plugin.cfg")

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true

[sub_resource type="Shader" id="DayPane"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;
uniform sampler2D painted_view : source_color, filter_linear_mipmap;
void fragment() {
 vec3 view_color = texture(painted_view, UV * vec2(1.0,0.625)).rgb;
 ALBEDO = mix(view_color, vec3(0.85,0.86,0.65), 0.54);
}"


[configuration]
entry_symbol = "sensen_photo_picker_init"
compatibility_minimum = "4.7"

[libraries]
ios.debug.arm64 = "res://native/photo_picker/bin/libsensen_photo_picker.ios.template_debug.arm64.a"
ios.release.arm64 = "res://native/photo_picker/bin/libsensen_photo_picker.ios.template_release.arm64.a"
macos.debug.arm64 = "res://native/photo_picker/bin/libsensen_photo_picker.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://native/photo_picker/bin/libsensen_photo_picker.macos.template_release.arm64.dylib"

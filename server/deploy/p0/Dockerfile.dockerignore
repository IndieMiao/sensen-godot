# P0 image build context (server/deploy/p0/Dockerfile, BuildKit reads this file instead of the root .dockerignore).
# Only what the P0 server needs; never the demo APK's assets/p0/demo_server.json (it holds a demo key).
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/blueprint-core/**
!server/**
!assets/p0/p0_content.json
!assets/p0/content/**
!assets/p0/p0_outposts.json
!assets/p0/p0_ponds.json
!assets/p0/city_clusters.json
!assets/p0/legal/versions.json
!assets/ponds/catalog.json
!assets/avatar/parts_manifest.json
!assets/avatar/demo_denylist.json
!assets/avatar/npc_only.json
server/node_modules
server/.env
server/.env.*
server/output
packages/blueprint-core/node_modules
# q(188) ① Near you: the pinned DB-IP City Lite month (deploy-hk.sh build copies it from the devserver cache)
!dbip/dbip-city-lite-*.csv.gz

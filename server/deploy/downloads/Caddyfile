{
	auto_https disable_redirects
}

http://download-us.sensenjoy.cn {
	redir https://download-us.sensenjoy.cn:8443{uri} permanent
}

https://download-us.sensenjoy.cn:8443 {
	@releases path /farm/releases/*
	handle @releases {
		root * /srv/sensen-downloads
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
		}
		@apk path *.apk
		header @apk {
			Content-Type application/vnd.android.package-archive
			Content-Disposition attachment
		}
		file_server
	}
	handle {
		respond "Not found" 404
	}
}

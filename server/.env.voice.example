# Copy to server/.env.voice.local (ignored). Never put these credentials in a client APK.
LIVEKIT_URL=wss://voice-dev.sensenjoy.cn
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# cloud for LiveKit Cloud; self-hosted for an independently managed server.
LIVEKIT_MODE=self-hosted
VOICE_NAMESPACE=sensen-voice-dev
VOICE_MAX_PARTICIPANTS=8
VOICE_MAX_TOTAL_PARTICIPANTS=16

# 复制成 .env（gitignored）。生产上放在 /opt/farm/.env 且 chmod 600。
DATABASE_URL=postgres://farm:CHANGEME@192.168.124.53:5432/sensen_farm_dev
TEST_DATABASE_URL=postgres://farm:CHANGEME@192.168.124.53:5432/sensen_farm_test
# openssl rand -hex 32
TOKEN_PEPPER=CHANGEME
# 逗号分隔的 player_id；只有他们建出来的农场带 qa 标记，客户端不能自设
QA_PLAYER_IDS=
PORT=3000
# D2 账号服务：Firebase 项目 id（开发期 gensen-overseas-dev）。不设则账号路由 503。
FIREBASE_PROJECT_ID=gensen-overseas-dev
# D4-c 图片直传：Cloudflare R2（S3 兼容）。四项缺一则上传路由 503。R2_PUBLIC_BASE 是公网读的自定义域。
R2_ENDPOINT=https://CHANGEME.r2.cloudflarestorage.com
R2_BUCKET=sensen-ugc-dev
R2_ACCESS_KEY_ID=CHANGEME
R2_SECRET_ACCESS_KEY=CHANGEME
R2_REGION=auto
R2_PUBLIC_BASE=
# 没有 R2 时的开发期本地图片存储目录（与 R2 二选一）；客户端统一读 /v1/files/<key>
UPLOAD_LOCAL_DIR=.uploads
# D6 审核：OpenAI omni-moderation（不设则不拦，全部进人工队列）；能看 /v1/admin/* 的自有 user id，逗号分隔
OPENAI_API_KEY=
ADMIN_USER_IDS=
# 备份加密的 age 公钥（私钥只在本机 ~/.config/sensen/farm-backup.key，不上服务器）
AGE_RECIPIENT=age1CHANGEME
OSS_BUCKET=sensen-farm-backup
# D7 推送：Firebase 服务账号（JSON 内容或文件路径，二选一）。不设则推送空转。
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
# E4 服务端错误上报（Sentry DSN）。不设则空转。
SENTRY_DSN=


# 复制成 .env（gitignored）。生产上放在 /opt/farm/.env 且 chmod 600。
DATABASE_URL=postgres://farm:CHANGEME@192.168.124.53:5432/sensen_farm_dev
TEST_DATABASE_URL=postgres://farm:CHANGEME@192.168.124.53:5432/sensen_farm_test
# openssl rand -hex 32
TOKEN_PEPPER=CHANGEME
# 逗号分隔的 player_id；只有他们建出来的农场带 qa 标记，客户端不能自设
QA_PLAYER_IDS=
PORT=3000
# Comma-separated IPs/CIDRs for reverse proxies. Empty ignores forwarded client IPs.
# Use only the private proxy network; never 0.0.0.0/0. Keep the app port private.
TRUSTED_PROXIES=
# 备份加密的 age 公钥（私钥只在本机 ~/.config/sensen/farm-backup.key，不上服务器）
AGE_RECIPIENT=age1CHANGEME
OSS_BUCKET=sensen-farm-backup

# —— 账号与全球城市（SGODOT-135 / 136） ——
# 验证码发信。配了就走 SMTP（阿里云邮件推送 / SES / 企业邮箱均可）；不配则把验证码打在服务端日志里。
SMTP_URL=
MAIL_FROM=Sensen <no-reply@sensenjoy.cn>
# 不配 SMTP 时日志是否打出明文验证码；生产配了 SMTP 后可设 0。
EMAIL_LOG_CODES=1
# 这个域名下的邮箱固定用 QA_EMAIL_CODE、不发信，供自动化与 QA 账号使用。生产上要么不配，要么用不可注册的域名。
QA_EMAIL_DOMAIN=qa.sensen.test
QA_EMAIL_CODE=
# DB-IP City Lite 数据库路径（选城页按 IP 预填城市）。不配就不给默认城市。
IP_CITY_DB=
# 仅开发服：允许游客（install_key）建农场。生产不设，游客只读。
GUEST_WRITES=
# Sign in with Apple：允许作为 identity token aud 的 iOS bundle id，逗号分隔；置空关闭 Apple 登录。
APPLE_BUNDLE_IDS=app.gensen.maps

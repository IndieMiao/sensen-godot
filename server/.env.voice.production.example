# Production secret-store template. Use the separate Aliyun PROD service key.
# Inject into the existing game server process; never add to client export files.
LIVEKIT_URL=wss://voice.sensenjoy.cn
# Server-to-server API on the same ECS; never returned to phones.
LIVEKIT_ADMIN_URL=http://172.18.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MODE=self-hosted
VOICE_NAMESPACE=sensen-voice-prod
VOICE_MAX_PARTICIPANTS=8
VOICE_MAX_TOTAL_PARTICIPANTS=32

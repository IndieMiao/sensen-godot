msgid "An account with this email already exists."
msgstr "该邮箱已注册。"

msgid "Back"
msgstr "返回"

msgid "Before you start"
msgstr "开始之前"

msgid "Chats"
msgstr "消息"

msgid "Chats land in B2: conversations, 1:1 and group chat, images, read receipts."
msgstr "消息功能将在 B2 接入：会话列表、单聊与群聊、图片、已读回执。"

msgid "Clear log"
msgstr "清空日志"

msgid "Contact us"
msgstr "联系我们"

msgid "Continue"
msgstr "继续"

msgid "Continue with Apple"
msgstr "通过 Apple 继续"

msgid "Continue with Google"
msgstr "通过 Google 继续"

msgid "Create account"
msgstr "创建账号"

msgid "Creating account…"
msgstr "正在创建账号…"

msgid "Delete"
msgstr "删除"

msgid "Delete account"
msgstr "删除账号"

msgid "Delete account?"
msgstr "删除账号？"

msgid "Deleting account…"
msgstr "正在删除账号…"

msgid "Dev: continue offline"
msgstr "开发：离线继续"

msgid "Dev: lifecycle probe"
msgstr "开发：生命周期探针"

msgid "Dressing room"
msgstr "换装房"

msgid "Email"
msgstr "邮箱"

msgid "Email not verified"
msgstr "邮箱未验证"

msgid "Email or password is incorrect."
msgstr "邮箱或密码不正确。"

msgid "Email verified"
msgstr "邮箱已验证"

msgid "Enter a valid email address."
msgstr "请输入有效的邮箱地址。"

msgid "Feed"
msgstr "动态"

msgid "Feed lands in B3: timeline, photo composer, likes, comments and report."
msgstr "动态将在 B3 接入：时间线、图文发布、点赞、评论与举报。"

msgid "Forgot password"
msgstr "忘记密码"

msgid "I have read and agree to the Terms of Service and Privacy Policy."
msgstr "我已阅读并同意《服务条款》与《隐私政策》。"

msgid "Language: %s"
msgstr "语言：%s"

msgid "Lifecycle probe"
msgstr "生命周期探针"

msgid "Map"
msgstr "地图"

msgid "Map home lands in B5: Mapbox underlay, friends' positions and 3D avatars. This tab stays resident so the native map view can be shown/hidden instead of rebuilt."
msgstr "地图主页将在 B5 接入：Mapbox 底图、好友位置与 3D 角色。此页常驻，原生地图只做显隐、不重建。"

msgid "Me"
msgstr "我"

msgid "No connection. Check your network and try again."
msgstr "网络不可用，请检查网络后重试。"

msgid "Not signed in"
msgstr "未登录"

msgid "Password (6+ characters)"
msgstr "密码（至少 6 位）"

msgid "Password must be at least 6 characters."
msgstr "密码至少 6 位。"

msgid "Password reset email sent."
msgstr "重置密码邮件已发送。"

msgid "Please select your full date of birth."
msgstr "请选择完整的出生日期。"

msgid "Please sign in again, then delete your account."
msgstr "请重新登录后再删除账号。"

msgid "Privacy policy"
msgstr "隐私政策"

msgid "Profile lands in B4: profile card, edit, avatar entry, Space 3D."
msgstr "我的主页将在 B4 接入：资料卡、编辑、形象入口、3D 空间。"

msgid "Realtime: %s"
msgstr "实时连接：%s"

msgid "Resend verification email"
msgstr "重发验证邮件"

msgid "Settings"
msgstr "设置"

msgid "Sign in"
msgstr "登录"

msgid "Sign out"
msgstr "退出登录"

msgid "Sign-in failed (%s)."
msgstr "登录失败（%s）。"

msgid "Sign-in is not configured yet (config/firebase.json)."
msgstr "登录尚未配置（config/firebase.json）。"

msgid "Sign-in is not configured yet."
msgstr "登录尚未配置。"

msgid "Signed in as %s (%s)"
msgstr "已登录：%s（%s）"

msgid "Signing in…"
msgstr "正在登录…"

msgid "Sorry, you're not eligible to use this app."
msgstr "很抱歉，你暂时不能使用本应用。"

msgid "Switch to another app and come back several times. Each PAUSED/RESUMED pair must increase by one."
msgstr "切到别的应用再回来，重复几次。每次 PAUSED / RESUMED 都应各加一。"

msgid "Tap here to test keyboard avoidance"
msgstr "点这里测试键盘避让"

msgid "Tell us your date of birth to get started."
msgstr "请填写出生日期以开始。"

msgid "Terms of service"
msgstr "服务条款"

msgid "This account has been disabled."
msgstr "该账号已被停用。"

msgid "This community has zero tolerance for abusive content or behavior. Content you post can be reported and removed, and repeat offenders are banned."
msgstr "本社区对辱骂、骚扰等不当内容与行为零容忍。你发布的内容可能被举报并移除，屡犯者将被封禁。"

msgid "This permanently deletes your account and data. This cannot be undone."
msgstr "这将永久删除你的账号与数据，且无法撤销。"

msgid "This sign-in method is not enabled."
msgstr "该登录方式未启用。"

msgid "Too many attempts. Try again later."
msgstr "尝试次数过多，请稍后再试。"

msgid "Verification email sent."
msgstr "验证邮件已发送。"

msgid "Voice room"
msgstr "语音房"

msgid "Voice room lands in B6 (UI), C4 (LiveKit bridge) and D5 (token/signaling)."
msgstr "语音房将在 B6（界面）、C4（LiveKit 桥接）与 D5（令牌 / 信令）接入。"

msgid "Welcome"
msgstr "欢迎"

msgid "connected"
msgstr "已连接"

msgid "connecting"
msgstr "连接中"

msgid "idle"
msgstr "空闲"

msgid "paused"
msgstr "已暂停"

msgid "reconnecting"
msgstr "重连中"

msgid "Couldn't delete your account on the server. Check your connection and try again."
msgstr "服务器上的账号删除失败，请检查网络后重试。"

msgid "%s · %d followers · %d following"
msgstr "%s · %d 粉丝 · %d 关注"

msgid "Avatar upload and Space 3D land later in B4."
msgstr "形象上传与 3D 空间在 B4 后续接入。"

msgid "Bio"
msgstr "简介"

msgid "Can't reach the server. Check your connection and try again."
msgstr "连不上服务器，请检查网络后重试。"

msgid "Display name"
msgstr "昵称"

msgid "Handle (letters, numbers, _)"
msgstr "用户名（字母、数字、_）"

msgid "Please check the %s field."
msgstr "请检查 %s 字段。"

msgid "Profile saved."
msgstr "资料已保存。"

msgid "Save profile"
msgstr "保存资料"

msgid "Saving…"
msgstr "保存中…"

msgid "Sign in again to set up your profile."
msgstr "请重新登录以建立你的资料。"

msgid "That handle is already taken."
msgstr "这个用户名已被占用。"

# C3 原生扩展：godot-cpp 克隆与构建产物不进仓库（build_ios.sh 生成）
native/godot-cpp/
native/photo_picker/bin/*
!native/photo_picker/bin/libsensen_photo_picker.ios.template_debug.arm64.a
!native/photo_picker/bin/libsensen_photo_picker.ios.template_release.arm64.a
!native/photo_picker/bin/libsensen_photo_picker.macos.template_debug.arm64.dylib
!native/photo_picker/bin/libsensen_photo_picker.macos.template_release.arm64.dylib
native/photo_picker/android/.gradle/
native/photo_picker/android/build/
native/photo_picker/android/bin/*
!native/photo_picker/android/bin/*.aar
native/photo_picker/android/local.properties
native/photo_picker/.sconsign.dblite
native/photo_picker/src/*.o

# C2 推送原生扩展：同上，只入库最终 .a / .dylib（编译中间产物不进）
native/push/bin/*
!native/push/bin/libsensen_push.ios.template_debug.arm64.a
!native/push/bin/libsensen_push.ios.template_release.arm64.a
!native/push/bin/libsensen_push.macos.template_debug.arm64.dylib
!native/push/bin/libsensen_push.macos.template_release.arm64.dylib
native/push/.sconsign.dblite
native/push/src/*.o
native/push/src/*.os
native/push/src_stub/*.o
native/push/src_stub/*.os
native/push/android/.gradle/
native/push/android/build/
native/push/android/bin/*
!native/push/android/bin/*.aar
native/push/android/local.properties

# C4 语音原生扩展：同上
native/voice/bin/*
!native/voice/bin/libsensen_voice.ios.template_debug.arm64.a
!native/voice/bin/libsensen_voice.ios.template_release.arm64.a
!native/voice/bin/libsensen_voice.macos.template_debug.arm64.dylib
!native/voice/bin/libsensen_voice.macos.template_release.arm64.dylib
native/voice/.sconsign.dblite
native/voice/src/*.o
native/voice/src/*.os
native/voice/src_stub/*.o
native/voice/src_stub/*.os
native/voice/android/.gradle/
native/voice/android/build/
native/voice/android/bin/*
!native/voice/android/bin/*.aar
native/voice/android/local.properties

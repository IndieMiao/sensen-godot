extends SceneTree
func _initialize():
	var config := ConfigFile.new()
	assert(config.load("res://override.cfg") == OK)
	config.set_value("application","run/main_scene","res://android_review.tscn")
	config.set_value("display","window/size/viewport_width",360)
	config.set_value("display","window/size/viewport_height",800)
	config.set_value("display","window/stretch/mode","canvas_items")
	config.set_value("display","window/stretch/aspect","expand")
	config.set_value("display","window/handheld/orientation",1)
	config.set_value("display","window/frame_pacing/android/enable_frame_pacing",false)
	config.set_value("rendering","textures/vram_compression/import_etc2_astc",true)
	assert(config.save("res://override.cfg") == OK)
	# The exported APK does not inherit an editor-only override.cfg. Materialize
	# every override into this disposable project's actual project.godot.
	var project := ConfigFile.new()
	assert(project.load("res://project.godot") == OK)
	for section in config.get_sections():
		for key in config.get_section_keys(section):
			project.set_value(section,key,config.get_value(section,key))
	assert(project.save("res://project.godot") == OK)
	var preset := ConfigFile.new()
	preset.set_value("preset.0","name","Android Wild Ground QA")
	preset.set_value("preset.0","platform","Android")
	preset.set_value("preset.0","runnable",true)
	preset.set_value("preset.0","export_filter","all_resources")
	preset.set_value("preset.0","include_filter","*.json")
	preset.set_value("preset.0","exclude_filter","addons/gdUnit4/*,assets/avatar/source/*.fbx")
	preset.set_value("preset.0.options","gradle_build/use_gradle_build",false)
	preset.set_value("preset.0.options","architectures/arm64-v8a",false)
	preset.set_value("preset.0.options","architectures/x86_64",true)
	preset.set_value("preset.0.options","version/code",42201)
	preset.set_value("preset.0.options","version/name","422-ground-art")
	preset.set_value("preset.0.options","package/unique_name","com.sensen.wildground422qa")
	preset.set_value("preset.0.options","package/name","Wild Ground Art QA")
	preset.set_value("preset.0.options","package/signed",true)
	assert(preset.save("res://export_presets.cfg") == OK)
	FileAccess.open("res://android_review.tscn",FileAccess.WRITE).store_string('[gd_scene load_steps=2 format=3]\n[ext_resource type="Script" path="res://android_review.gd" id="1"]\n[node name="GroundInputReview" type="Node"]\nscript=ExtResource("1")\n')
	quit()
